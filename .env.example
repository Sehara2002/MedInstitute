# Copy to .env.local and fill in. Placeholders only - never commit real values.

# --- CITech LMS backend ---
# Course catalogue, read on the server (origin only, no /api)
CITECH_API_URL=http://localhost:5000
# LMS website, where free courses are joined
CITECH_LMS_URL=http://localhost:3000
# Mock exams, called from the browser (with /api); production: https://lms.citech.live/api
NEXT_PUBLIC_LMS_API_URL=http://localhost:5000/api
# Registration / payment -> LMS account creation, on the server (with /api)
LMS_BACKEND_URL=http://localhost:5000/api
NEXT_PUBLIC_LMS_FRONTEND_URL=http://localhost:3000

# --- This site's public address (payment return URLs, emails) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
WEBSITE_URL=http://localhost:3001

# --- Databases (both required; there is no built-in default) ---
# Users, login, dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Course registrations
VPS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# --- Auth (NextAuth) ---
AUTH_SECRET=generate-a-long-random-value
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Gmail app password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Payment gateway (Commercial Bank MPGS) ---
MPGS_MERCHANT_ID=
MPGS_API_PASSWORD=
MPGS_GATEWAY_URL=https://cbcmpgs.gateway.mastercard.com
MPGS_API_VERSION=100
MPGS_CURRENCY=LKR
NEXT_PUBLIC_MPGS_GATEWAY_URL=https://cbcmpgs.gateway.mastercard.com
NEXT_PUBLIC_CURRENCY=LKR

# Simulated payments (?testMode=true) mark a registration paid without the gateway.
# Only honoured when "true" AND not in production. Never set this in production.
ALLOW_TEST_PAYMENTS=false
