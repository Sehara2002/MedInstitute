# MRCGP Fast Track website - environment
# Copy to .env.local for local development. Set the same names on Vercel.
# This site has no database of its own: accounts, registrations, payments and
# LMS content are all reached through the LMS backend.

# --- LMS backend (required) -------------------------------------------------
# The backend API, including /api. Server-side only.
LMS_BACKEND_URL=http://localhost:5000/api
# Shared secret: must equal WEBSITE_API_KEY in the backend's environment
WEBSITE_API_KEY=

# --- Sign-in (Auth.js) --------------------------------------------------------
AUTH_SECRET=
# AUTH_TRUST_HOST=true   # needed when self-hosting behind a proxy (not on Vercel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Website sign-up welcome emails ------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional -----------------------------------------------------------------
# Currency online payment is taken in (default LKR)
# MPGS_CURRENCY=LKR
# NEXT_PUBLIC_CURRENCY=LKR
